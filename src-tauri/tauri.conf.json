{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metabase Desktop",
  "version": "0.1.0",
  "identifier": "com.anshori.metabase-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "Metabase Desktop",
        "url": "index.html",
        "width": 440,
        "height": 340,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "resources/runtime/": "resources/runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
